{
  "name": "yaqmc",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "android:studio": "node scripts/open-android-studio.mjs",
    "android:build": "node scripts/build-android-native.mjs",
    "android:build:debug": "node scripts/build-android-native.mjs --debug",
    "android:check": "node scripts/run-android-gradle.mjs :nativeApp:testDebugUnitTest :nativeApp:lintDebug",
    "docs:check": "node scripts/check-public-docs.mjs",
    "test": "node --test scripts/ci/*.test.mjs",
    "contracts:update": "node scripts/update-contract-fixtures.mjs",
    "contracts:check": "node scripts/update-contract-fixtures.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "provenance:report": "node scripts/validate-provenance-ledger.mjs",
    "provenance:enforce": "node scripts/validate-provenance-ledger.mjs --enforce"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
